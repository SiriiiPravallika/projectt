<!doctype html>
<html>
  <head>
    <meta charset="utf-8">
    <title>Check your email</title>
    <link rel="stylesheet" href="/styles.css">
  </head>
  <body>
    <main class="card">
      <h1>Verify your email</h1>
      <p>We've sent a verification link to <strong><%= email %></strong>.</p>
      <% if (previewUrl) { %>
        <p class="muted">Preview (ethereal): <a href="<%= previewUrl %>"><%= previewUrl %></a></p>
      <% } %>
      <% if (!previewUrl && verifyUrl) { %>
        <p class="muted">Verification link: <a href="<%= verifyUrl %>"><%= verifyUrl %></a></p>
      <% } %>
    </main>
  </body>
</html>
