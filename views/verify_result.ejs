<!doctype html>
<html>
  <head>
    <meta charset="utf-8">
    <title>Verification</title>
    <link rel="stylesheet" href="/styles.css">
  </head>
  <body>
    <main class="card">
      <% if (success) { %>
        <h1>Verified</h1>
        <p>Your email is verified. <a href="/dashboard">Go to dashboard</a></p>
      <% } else { %>
        <h1>Invalid token</h1>
        <p>Verification token is invalid or expired.</p>
      <% } %>
    </main>
  </body>
</html>
